<%- include("../partials/head", { tituloPagina: 'Checkout' }) %>

<link rel="stylesheet" href="/css/pages/checkout.css">
<!-- SweetAlert2: modais de confirmação (versão fixa) -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js" defer></script>
<script src="/js/pages/checkout.js" defer></script>

<%- include("../partials/header") %>

<main class="checkout-page">
    <% if (pedidoFinalizado) { %>
        <!-- data-*: o checkout.js lê o link e o número do pedido para abrir o WhatsApp sozinho -->
        <section class="checkout-card checkout-confirmacao" id="confirmacao-pedido"
                 data-pedido="<%= pedidoFinalizado.id_pedido %>"
                 data-link-whatsapp="<%= locals.linkWhatsApp || '' %>">
            <p class="checkout-selo">Pedido enviado</p>
            <h1>Obrigado pela sua compra!</h1>
            <p>Seu pedido <strong>#<%= pedidoFinalizado.id_pedido %></strong> foi registrado.</p>
            <p>Status: <strong>Aguardando aprovação da loja</strong></p>
            <p>Forma de pagamento: <strong><%= pedidoFinalizado.nome_pagamento %></strong></p>
            <p class="checkout-total">Total: <%= Number(pedidoFinalizado.total).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></p>
            <p class="checkout-aviso">Seu pedido ainda precisa ser aprovado pela loja. Envie a mensagem pelo WhatsApp e aguarde nossa confirmação. Depois, retire e pague na loja.</p>
            <div class="checkout-retirada">
                <h2>Retirada e pagamento</h2>
                <p><strong>Endereço:</strong> R. Quatorze de Julho, 880 – Vila Oriental, São João da Boa Vista – SP.</p>
                <p><strong>Horário:</strong> segunda a sexta, das 7h às 18h; sábado, das 7h30 às 12h.</p>
                <p><strong>Pagamento na loja:</strong> Pix, cartão de crédito, cartão débito ou dinheiro.</p>
            </div>

            <% if (locals.linkWhatsApp) { %>
                <!-- Abre o WhatsApp com a mensagem do pedido pronta para a loja; o cliente só aperta "enviar" -->
                <p class="checkout-whatsapp-texto">Envie o pedido para a loja pelo WhatsApp (abre em uma nova aba):</p>
            <% } %>

            <!-- Botões lado a lado; no celular quebram linha -->
            <div class="checkout-acoes">
            <% if (locals.linkWhatsApp) { %>
                <a class="checkout-botao checkout-botao-whatsapp" href="<%= linkWhatsApp %>" target="_blank" rel="noopener">
                    <img src="/img/icons/icons8-whatsapp-50.png" alt="" width="22" height="22">
                    Enviar pedido pelo WhatsApp
                </a>
            <% } %>

            <!-- Leva para a aba "Meus pedidos" da página Minha conta -->
            <a class="checkout-botao" href="/minha-conta?aba=pedidos">Acompanhar pedido</a>
            <a class="checkout-botao checkout-botao-secundario" href="/catalogo">Continuar comprando</a>
            </div>
        </section>
    <% } else { %>
        <section class="checkout-card">
            <!-- Volta para o carrinho para o cliente revisar ou alterar os itens -->
            <a class="checkout-voltar" href="/carrinho">&lsaquo; Voltar ao carrinho</a>

            <h1>Finalizar pedido</h1>
            <p class="checkout-intro">Confira os produtos do seu carrinho e escolha como pretende pagar.</p>

            <% if (erro) { %>
                <p class="checkout-erro" role="alert"><%= erro %></p>
            <% } %>

            <% if (!itens.length) { %>
                <p class="checkout-vazio">Seu carrinho está vazio.</p>
                <a class="checkout-botao" href="/catalogo">Voltar ao catálogo</a>
            <% } else { %>
                <div class="checkout-itens">
                    <% itens.forEach(item => { %>
                        <div class="checkout-item">
                            <div>
                                <strong><%= item.titulo_produto %></strong>
                                <span>Quantidade: <%= item.quantidade %></span>
                            </div>
                            <span><%= Number(item.subtotal).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></span>
                        </div>
                    <% }) %>
                </div>

                <p class="checkout-total">Total: <%= Number(total).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></p>

                <% if (formasPagamento.length) { %>
                    <!-- O checkout.js intercepta o envio e mostra o modal de confirmação -->
                    <form action="/checkout" method="post" id="form-checkout"
                          data-whatsapp="<%= locals.whatsappAtivo ? 'sim' : 'nao' %>">
                        <label for="forma_pagamento_id">Forma de pagamento</label>
                        <input type="hidden" name="itens" value="<%= itens.map(item => item.produto_sku).join(',') %>">
                        <select id="forma_pagamento_id" name="forma_pagamento_id" required>
                            <option value="">Selecione uma opção</option>
                            <% formasPagamento.forEach(forma => { %>
                                <option value="<%= forma.id_forma_pagamento %>"><%= forma.nome_pagamento %></option>
                            <% }) %>
                        </select>
                        <p class="checkout-aviso">O pedido será enviado como solicitação. O pagamento não é processado nesta página.</p>
                        <button class="checkout-botao" type="submit">Confirmar pedido</button>
                    </form>
                <% } else { %>
                    <p class="checkout-erro">Não há formas de pagamento disponíveis no momento.</p>
                <% } %>
            <% } %>
        </section>
    <% } %>
</main>

<%- include("../partials/footer") %>
