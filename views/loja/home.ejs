    <%- include("../partials/head", { tituloPagina: 'Início' })  %>

    <link rel="stylesheet" href="/css/pages/home.css">

    <%- include("../partials/header") %>

    <%
      // Procura a categoria pelo nome para montar o link do banner.
      // Se não achar (nome mudou no banco), o botão leva para o catálogo inteiro.
      function linkCategoria(nome) {
        const categoria = navbarCategorias.find(c => c.nome.toLowerCase() === nome.toLowerCase())
        return categoria ? '/catalogo?categoria=' + categoria.id_categoria : '/catalogo'
      }
    %>

    <!-- HERO -->
    <section class="hero">
        <!-- SLIDES -->
        <div class="slide active">
            <img src="/img/banners/image.png" alt="Banner 1">

            <div class="hero-content">
                <h1>Promoção de<br>Cabos Elétricos</h1>

                <p>Alta qualidade para<br>instalações seguras</p>

                <a class="hero-botao" href="<%= linkCategoria('Fios e cabos') %>">Ver produtos</a>
            </div>
        </div>

        <div class="slide">
            <img src="/img/banners/Banner2.png" alt="Banner 2">

            <div class="hero-content">
                <h1>Ferramentas<br>Profissionais</h1>

                <p>Os melhores preços<br>para sua obra</p>

                <a class="hero-botao" href="<%= linkCategoria('Ferramentas') %>">Comprar agora</a>
            </div>
        </div>

        <div class="slide">
            <img src="/img/banners/Banner3.png" alt="Banner 3">

            <div class="hero-content">
                <h1>Iluminação<br>Residencial</h1>

                <p>Modernidade e economia</p>

                <a class="hero-botao" href="<%= linkCategoria('Iluminação') %>">Explorar</a>
            </div>
        </div>

        <!-- BOLINHAS -->
        <div class="dots">
            <span class="dot active"></span>
            <span class="dot"></span>
            <span class="dot"></span>
        </div>
    </section>

    <div class="container">


        <!-- BENEFÍCIOS -->
        <section class="benefits">

            <div class="benefit-card">
                <div class="icons"><img src="/img/icons/Cartao.png" alt=""></div>

                <div>
                    <h4>Parcelamento</h4>
                    <p>Até 12x Cartão</p>
                </div>
            </div>

            <div class="benefit-card">
                <div class="icons"><img src="/img/icons/Caixa.png" alt=""></div>

                <div>
                    <h4>Retirada na loja</h4>
                    <p>Estoque imediato</p>
                </div>
            </div>

            <div class="benefit-card">
                <div class="icons"><img src="/img/icons/dinheiro.png" alt=""></div>

                <div>
                    <h4>Descontos Especiais</h4>
                    <p>Para pagamentos via Pix</p>
                </div>
            </div>

        </section>

        <!-- CATEGORIAS -->
        <section class="section">

            <div class="section-title">
                <h2>Principais <span>Categorias</span></h2>
            </div>

            <div class="categories">
                <% navbarPrincipais.slice(0, 4).forEach(function (categoria) { %>
                    <a class="category-card" href="/catalogo?categoria=<%= categoria.id_categoria %>" aria-label="Ver produtos da categoria <%= categoria.nome %>">
                        <img src="/img/icons/icons8-caixa-128.png" alt="">
                        <p><%= categoria.nome %></p>
                    </a>
                <% }) %>
            </div>

        </section>

        <!-- PRODUTOS: os mais vendidos vêm do banco pela rota GET / (routes/loja.js) -->
        <section class="section">

            <div class="section-header">
                <h2>Mais <span>Vendidos</span></h2>

                <a href="/catalogo">Ver mais</a>
            </div>

            <% if (erroProdutos) { %>
                <p class="produtos-aviso">Não foi possível carregar os produtos agora.</p>
            <% } else if (maisVendidos.length === 0) { %>
                <p class="produtos-aviso">Nenhum produto cadastrado ainda.</p>
            <% } %>

            <div class="products">
                <% maisVendidos.forEach(function (produto) {
                     const [reais, centavos] = Number(produto.preco_produto).toFixed(2).split('.')
                %>
                <div class="product-card">

                    <a href="/produto?id=<%= produto.sku %>">
                        <img src="<%= produto.imagem || '/img/icons/icons8-caixa-128.png' %>" alt="<%= produto.titulo_produto %>" loading="lazy"
                             onerror="this.onerror=null; this.src='/img/icons/icons8-caixa-128.png'">
                    </a>

                    <div class="product-info">
                        <p class="product-name">
                            <a href="/produto?id=<%= produto.sku %>"><%= produto.titulo_produto %></a>
                        </p>

                        <h3>R$ <%= reais %><span>,<%= centavos %></span></h3>

                        <% if (produto.estoque_produto > 0) { %>
                            <button type="button" data-id="<%= produto.sku %>">Adicionar ao carrinho</button>
                        <% } else { %>
                            <button type="button" disabled>Sem estoque</button>
                        <% } %>
                    </div>

                </div>
                <% }) %>
            </div>

        </section>

        <!-- Convite para cadastro: só aparece para quem NÃO está logado -->
        <% if (!usuario) { %>
        <section class="anuncio">

            <div class="propaganda">
                <div class="texto-propaganda">
                    <h1>Cadastre e aproveite nossas ofertas!</h1>
                    <p>Materiais elétricos com os melhores preços</p>
                    <a class="botao-propaganda" href="/registro">Cadastre-se</a>
                </div>
            </div>

        </section>
        <% } %>

        <section class="avaliacoes">


            <div class="section-title">
                <h2>Avaliações de <span>Clientes</span></h2>
            </div>

            <div class="cards-avaliacao-principal">

                <div class="cards-avaliacao1">
                    <div class="test">
                        <div class="avatar">
                            <img src="/img/icons/userblack.png" alt="">
                        </div>
                        <div class="user-info">
                            <h3>Nome usuario</h3>
                            <div class="stars">★★★★★</div>
                        </div>

                    </div>

                    <p class="review-text">
                        "Produto chegou antes do prazo, embalado com muito cuidado.
                        Qualidade excelente, vou comprar de novo!"
                    </p>
                </div>



                <div class="cards-avaliacao1">
                    <div class="test">
                        <div class="avatar">
                            <img src="/img/icons/userblack.png" alt="">
                        </div>
                        <div class="user-info">
                            <h3>Nome usuario</h3>
                            <div class="stars">★★★★★</div>
                        </div>
                    </div>

                    <p class="review-text">
                        "Melhor loja elétrica online! Preços competitivos e atendimento rápido. Super recomendo."
                    </p>
                </div>
                <div class="cards-avaliacao1">
                    <div class="test">
                        <div class="avatar">
                            <img src="/img/icons/userblack.png" alt="">
                        </div>
                        <div class="user-info">
                            <h3>Nome usuario</h3>
                            <div class="stars">★★★★★</div>
                        </div>
                    </div>
                    <p class="review-text">
                        "Produto original e bem embalado. Demorou 2 dias a mais que o previsto, mas valeu a espera."
                    </p>
                </div>


        </section>

    </div>


    <script src="/js/pages/home.js" defer></script>
    
    <%- include("../partials/footer") %>

