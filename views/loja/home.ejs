    <%- include("../partials/head", { tituloPagina: 'Início' })  %>

    <link rel="stylesheet" href="/css/pages/home.css">

    <%- include("../partials/header") %>

    <!-- HERO -->
    <section class="hero">
        <!-- SLIDES -->
        <div class="slide active">
            <img src="/img/banners/image.png" alt="Banner 1">

            <div class="hero-content">
                <h1>Promoção de<br>Cabos Elétricos</h1>

                <p>Alta qualidade para<br>instalações seguras</p>

                <button>Ver produtos</button>
            </div>
        </div>

        <div class="slide">
            <img src="/img/banners/Banner2.png" alt="Banner 2">

            <div class="hero-content">
                <h1>Ferramentas<br>Profissionais</h1>

                <p>Os melhores preços<br>para sua obra</p>

                <button>Comprar agora</button>
            </div>
        </div>

        <div class="slide">
            <img src="/img/banners/Banner3.png" alt="Banner 3">

            <div class="hero-content">
                <h1>Iluminação<br>Residencial</h1>

                <p>Modernidade e economia</p>

                <button>Explorar</button>
            </div>
        </div>

        <!-- BOLINHAS -->
        <div class="dots">
            <span class="dot active"></span>
            <span class="dot"></span>
            <span class="dot"></span>
        </div>
    </section>

    <div class="container">


        <!-- BENEFÍCIOS -->
        <section class="benefits">

            <div class="benefit-card">
                <div class="icons"><img src="/img/icons/Cartao.png" alt=""></div>

                <div>
                    <h4>Parcelamento</h4>
                    <p>Até 12x Cartão</p>
                </div>
            </div>

            <div class="benefit-card">
                <div class="icons"><img src="/img/icons/Caixa.png" alt=""></div>

                <div>
                    <h4>Retirada na loja</h4>
                    <p>Estoque imediato</p>
                </div>
            </div>

            <div class="benefit-card">
                <div class="icons"><img src="/img/icons/dinheiro.png" alt=""></div>

                <div>
                    <h4>Descontos Especiais</h4>
                    <p>Para pagamentos via Pix</p>
                </div>
            </div>

        </section>

        <!-- COMO FUNCIONA: explica o jeito de comprar da loja (sem pagamento online).
             Ícones em SVG escritos aqui mesmo (desenhos da biblioteca Lucide, licença livre):
             não dependem de internet nem de biblioteca externa, e a cor vem do CSS (currentColor). -->
        <%
          // Mude para true quando a página /como-comprar existir (card do Trello).
          // Enquanto for false, o botão não aparece, para não levar o cliente a uma página de erro.
          const paginaComoComprarPronta = false
        %>
        <section class="como-funciona">
            <div class="como-funciona-topo">
                <h2>Como <span>funciona</span></h2>
                <p>Comprar na LuzForte é simples. Você não paga nada pelo site.</p>
            </div>

            <ol class="passos">
                <li class="passo">
                    <div class="passo-circulo">
                        <svg class="passo-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                        <span class="passo-numero">1</span>
                    </div>
                    <h3>Escolha os produtos</h3>
                    <p>Navegue pelo catálogo e coloque no carrinho tudo o que precisa.</p>
                </li>
                <li class="passo">
                    <div class="passo-circulo">
                        <svg class="passo-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>
                        <span class="passo-numero">2</span>
                    </div>
                    <h3>Finalize o pedido</h3>
                    <p>Entre na sua conta e escolha como vai pagar: Pix, cartão ou dinheiro.</p>
                </li>
                <li class="passo passo--whatsapp">
                    <div class="passo-circulo">
                        <svg class="passo-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                        <span class="passo-numero">3</span>
                    </div>
                    <h3>Envie pelo WhatsApp</h3>
                    <p>A mensagem do pedido já vai pronta. A loja confere e confirma.</p>
                </li>
                <li class="passo">
                    <div class="passo-circulo">
                        <svg class="passo-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/><path d="M22 7v3a2 2 0 0 1-2 2 2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12a2 2 0 0 1-2-2V7"/></svg>
                        <span class="passo-numero">4</span>
                    </div>
                    <h3>Retire na loja</h3>
                    <p>Com o pedido confirmado, é só passar na loja, pagar e levar.</p>
                </li>
            </ol>

            <% if (paginaComoComprarPronta) { %>
                <div class="como-funciona-acao">
                    <a class="como-funciona-botao" href="/como-comprar">Saiba mais sobre como comprar</a>
                </div>
            <% } %>
        </section>

        <!-- CATEGORIAS -->
        <section class="section">

            <div class="section-title">
                <h2>Principais <span>Categorias</span></h2>
            </div>

            <div class="categories">
                <% navbarPrincipais.slice(0, 4).forEach(function (categoria) { %>
                    <a class="category-card" href="/catalogo?categoria=<%= categoria.id_categoria %>" aria-label="Ver produtos da categoria <%= categoria.nome %>">
                        <img src="/img/icons/icons8-caixa-128.png" alt="">
                        <p><%= categoria.nome %></p>
                    </a>
                <% }) %>
            </div>

        </section>

        <!-- PRODUTOS -->
        <section class="section">

            <div class="section-header">
                <h2>Mais <span>Vendidos</span></h2>

                <a href="">Ver mais</a>
            </div>

            <div class="products">

                <div class="product-card">

                    <img src="/img/products/fios.png" alt="">

                    <div class="product-info">
                        <p class="product-name">
                            Fio Elétrico Cabo Flexível 1 via 1,50mm Azul
                        </p>

                        <span class="old-price">R$ 69,90</span>

                        <h3>R$ 49<span>,99</span></h3>

                        <button>Adicionar ao carrinho</button>
                    </div>

                </div>

                <div class="product-card">

                    <img src="/img/products/fios.png" alt="">

                    <div class="product-info">
                        <p class="product-name">
                            Fio Elétrico Cabo Flexível 1 via 1,50mm Azul
                        </p>

                        <span class="old-price">R$ 69,90</span>

                        <h3>R$ 49<span>,99</span></h3>

                        <button>Adicionar ao carrinho</button>
                    </div>

                </div>

                <div class="product-card">

                    <img src="/img/products/fios.png" alt="">

                    <div class="product-info">
                        <p class="product-name">
                            Fio Elétrico Cabo Flexível 1 via 1,50mm Azul
                        </p>

                        <span class="old-price">R$ 69,90</span>

                        <h3>R$ 49<span>,99</span></h3>

                        <button>Adicionar ao carrinho</button>
                    </div>

                </div>

                <div class="product-card">

                    <img src="/img/products/fios.png" alt="">

                    <div class="product-info">
                        <p class="product-name">
                            Fio Elétrico Cabo Flexível 1 via 1,50mm Azul
                        </p>

                        <span class="old-price">R$ 69,90</span>

                        <h3>R$ 49<span>,99</span></h3>

                        <button>Adicionar ao carrinho</button>
                    </div>

                </div>

            </div>

        </section>

        <section class="anuncio">

            <div class="propaganda">
                <div class="texto-propaganda">
                    <h1>Cadastre e aproveite nossas ofertas!</h1>
                    <p>Materiais elétricos com os melhores preços</p>
                    <button><a href="/login">Cadastre-se</a></button>
                </div>
            </div>

        </section>

        <section class="avaliacoes">


            <div class="section-title">
                <h2>Avaliações de <span>Clientes</span></h2>
            </div>

            <div class="cards-avaliacao-principal">

                <div class="cards-avaliacao1">
                    <div class="test">
                        <div class="avatar">
                            <img src="/img/icons/userblack.png" alt="">
                        </div>
                        <div class="user-info">
                            <h3>Nome usuario</h3>
                            <div class="stars">★★★★★</div>
                        </div>

                    </div>

                    <p class="review-text">
                        "Produto chegou antes do prazo, embalado com muito cuidado.
                        Qualidade excelente, vou comprar de novo!"
                    </p>
                </div>



                <div class="cards-avaliacao1">
                    <div class="test">
                        <div class="avatar">
                            <img src="/img/icons/userblack.png" alt="">
                        </div>
                        <div class="user-info">
                            <h3>Nome usuario</h3>
                            <div class="stars">★★★★★</div>
                        </div>
                    </div>

                    <p class="review-text">
                        "Melhor loja elétrica online! Preços competitivos e atendimento rápido. Super recomendo."
                    </p>
                </div>
                <div class="cards-avaliacao1">
                    <div class="test">
                        <div class="avatar">
                            <img src="/img/icons/userblack.png" alt="">
                        </div>
                        <div class="user-info">
                            <h3>Nome usuario</h3>
                            <div class="stars">★★★★★</div>
                        </div>
                    </div>
                    <p class="review-text">
                        "Produto original e bem embalado. Demorou 2 dias a mais que o previsto, mas valeu a espera."
                    </p>
                </div>


        </section>

    </div>


    <script src="/js/pages/home.js" defer></script>
    
    <%- include("../partials/footer") %>

