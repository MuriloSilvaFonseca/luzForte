<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuzForte | Carrinho</title>
    <link rel="stylesheet" href="/css/components/header.css">
    <link rel="stylesheet" href="/css/components/footer.css">
    <link rel="stylesheet" href="/css/pages/carrinho.css">
</head>
<body>
 
    <%- include("../partials/header") %>
 
    <section class="alinhamentoCarrinho">
        <div class="pageWrapper">
 
            <div class="corpoCarrinho">
                <div class="parteSuperiorCarrinho">
                    <input type="checkbox" id="checkTodos">
                    <label for="checkTodos">Todos os produtos</label>
                </div>
 
                <hr class="linhaSeparadora">
 
                <div class="produtos">
                    <div class="checkCarrinho">
                        <input type="checkbox" id="prod1">
                    </div>
                    <div class="imagemCarrinho">
                        <img src="/img/products/lampada.png" >
                    </div>
                    <div class="acoesCarrinho">
                        <span class="nomeProduto">Disjuntor Tripolar WEG 30a Curva C</span>
                        <span class="badgeCategoria">Disjuntores</span>
                        <div class="controlesQty">
                            <button class="btnQty" onclick="mudarQty(this, -1)">−</button>
                            <span class="qtyValor">12</span>
                            <button class="btnQty" onclick="mudarQty(this, 1)">+</button>
                            <button class="btnFav" onclick="toggleFav(this)">
                                <i class="ti ti-heart" style="color:#aaa"></i>
                            </button>
                            <button class="btnDel">
                                <i class="ti ti-trash" style="color:#e24b4a"></i>
                            </button>
                        </div>
                    </div>
                    <div class="informacoesCarrinho">
                        <span class="precoOff">-15% OFF</span>
                        <span class="precoAtual">R$ 15,80</span>
                        <span class="precoUn">R$ 3,45 /un</span>
                    </div>
                </div>
 
                <hr class="linhaSeparadora">
 
                <div class="produtos">
                    <div class="checkCarrinho">
                        <input type="checkbox" id="prod2">
                    </div>
                    <div class="imagemCarrinho">
                        <img src="/img/products/fios.png">
                    </div>
                    <div class="acoesCarrinho">
                        <span class="nomeProduto">Disjuntor Tripolar WEG 30a Curva C</span>
                        <span class="badgeCategoria">Disjuntores</span>
                        <div class="controlesQty">
                            <button class="btnQty" onclick="mudarQty(this, -1)">−</button>
                            <span class="qtyValor">12</span>
                            <button class="btnQty" onclick="mudarQty(this, 1)">+</button>
                            <button class="btnFav" onclick="toggleFav(this)">
                                <i class="ti ti-heart" style="color:#aaa"></i>
                            </button>
                            <button class="btnDel">
                                <i class="ti ti-trash" style="color:#e24b4a"></i>
                            </button>
                        </div>
                    </div>
                    <div class="informacoesCarrinho">
                        <span class="precoOff">-15% OFF</span>
                        <span class="precoAtual">R$ 15,80</span>
                        <span class="precoUn">R$ 3,45 /un</span>
                    </div>
                </div>
 
                <hr class="linhaSeparadora">
 
                <div class="produtos">
                    <div class="checkCarrinho">
                        <input type="checkbox" id="prod3">
                    </div>
                    <div class="imagemCarrinho">
                        <img src="/img/products/furadeira.png">
                    </div>
                    <div class="acoesCarrinho">
                        <span class="nomeProduto">Disjuntor Tripolar WEG 30a Curva C</span>
                        <span class="badgeCategoria">Disjuntores</span>
                        <div class="controlesQty">
                            <button class="btnQty" onclick="mudarQty(this, -1)">−</button>
                            <span class="qtyValor">12</span>
                            <button class="btnQty" onclick="mudarQty(this, 1)">+</button>
                            <button class="btnFav" onclick="toggleFav(this)" data-ativo="true">
                                <i class="ti ti-heart-filled" style="color:#1a6be8"></i>
                            </button>
                            <button class="btnDel">
                                <i class="ti ti-trash" style="color:#e24b4a"></i>
                            </button>
                        </div>
                    </div>
                    <div class="informacoesCarrinho">
                        <span class="precoOff">-15% OFF</span>
                        <span class="precoAtual">R$ 15,80</span>
                        <span class="precoUn">R$ 3,45 /un</span>
                    </div>
                </div>
 
                <hr class="linhaSeparadora">
            </div>
 
            <div class="colunaDireita">
 
                <div class="resumoProduto">
                    <p class="tituloResumo">Resumo produtos:</p>
                    <hr class="linhaProduto">
                    <div class="linhaResumo">
                        <span class="labelResumo">Subtotal (100 itens):</span>
                        <span class="valorResumo">R$ 99,90</span>
                    </div>
                    <div class="linhaResumo">
                        <span class="labelResumo">Desconto (R$):</span>
                        <span class="descontoValor">R$ - 99,90</span>
                    </div>
                    <div class="linhaTotal">
                        <span class="labelTotal">Total (R$):</span>
                        <span class="valorTotal">R$ 99,90</span>
                    </div>
                    <div class="botaoCarrinhoFinalizar">
                        <button>Continuar com a compra</button>
                    </div>
                    <div class="compraSegura">
                        <i class="ti ti-lock" aria-hidden="true"></i>
                        <p class="legendaCompra">Compra 100% segura</p>
                    </div>
                </div>
 
                <div class="cupomDesconto">
                    <h2 class="textoCupom">Cupom de desconto:</h2>
                    <hr class="linhaProduto">
                    <h3 class="labelCupom">Insira aqui o cupom:</h3>
                    <input type="text" placeholder="">
                    <button class="botaoCarrinho">Aplicar desconto</button>
                </div>
 
            </div>
        </div>
    </section>
 
    <%- include("../partials/footer") %>
    
    <script src="/js/pages/carrinho.js"></script>
 
</body>
</html>