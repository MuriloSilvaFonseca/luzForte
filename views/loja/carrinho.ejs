<%- include("../partials/head", { tituloPagina: 'Carrinho' }) %>

    <link rel="stylesheet" href="/css/pages/carrinho.css">

 
    <%- include("../partials/header") %>
 
    <section class="alinhamentoCarrinho">
        <div class="pageWrapper">
 
            <div class="corpoCarrinho">
                <div class="parteSuperiorCarrinho">
                    <input type="checkbox" id="checkTodos">
                    <label for="checkTodos">Todos os produtos</label>
                    <button type="button" id="esvaziarCarrinho" class="btnDel" hidden>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" />
                        </svg>
                        <span>Esvaziar carrinho</span>
                    </button>
                </div>
 
                <hr class="linhaSeparadora">
 
                <p id="mensagemCarrinho" role="status">Carregando carrinho...</p>

                <div id="carrinhoVazio" class="carrinhoVazio" hidden>
                    <p class="carrinhoVazioTitulo">Seu carrinho está vazio.</p>
                    <a class="botaoCarrinhoVazio" href="/catalogo">Ver produtos</a>
                </div>
                <p class="orientacaoCarrinho">Desmarcar não remove o produto do carrinho.</p>
                <div id="itensCarrinho"></div>
                <template id="modeloItemCarrinho">
<div class="produtos">
                    <div class="checkCarrinho">
                        <input type="checkbox" aria-label="Selecionar produto">
                    </div>
                    <div class="imagemCarrinho">
                        <img src="/img/icons/icons8-caixa-128.png" alt="">
                    </div>
                    <div class="acoesCarrinho">
                        <span class="nomeProduto"></span>
                        <span class="badgeCategoria"></span>
                        <p class="avisoEstoqueCarrinho" role="status"></p>
                        <div class="controlesQty">
                            <button class="btnQty" onclick="mudarQty(this, -1)">−</button>
                            <span class="qtyValor">1</span>
                            <button class="btnQty" onclick="mudarQty(this, 1)">+</button>
                            <button type="button" class="btnDel">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                    <path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" />
                                </svg>
                                <span>Remover</span>
                            </button>
                        </div>
                    </div>
                    <div class="informacoesCarrinho">
                        <span class="precoOff" hidden></span>
                        <span class="precoAtual"></span>
                        <span class="precoUn"></span>
                    </div>
                </div>
                </template>
            </div>

            <div class="colunaDireita">
 
                <div class="resumoProduto">
                    <p class="tituloResumo">Resumo dos produtos selecionados:</p>
                    <p id="avisoSelecaoCarrinho" class="orientacaoCarrinho" role="status"></p>
                    <hr class="linhaProduto">
                    <div class="linhaResumo">
                        <span class="labelResumo">Subtotal (0 itens):</span>
                        <span class="valorResumo">R$ 0,00</span>
                    </div>
                    <div class="linhaTotal">
                        <span class="labelTotal">Total selecionado (R$):</span>
                        <span class="valorTotal">R$ 0,00</span>
                    </div>
                    <div class="botaoCarrinhoFinalizar">
                        <button type="button" disabled>Continuar com a compra</button>
                    </div>
                    <div class="compraSegura">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" />
                        </svg>
                        <p class="legendaCompra">Você paga na retirada, direto na loja.</p>
                    </div>
                    <a class="linkComoComprar" href="/como-comprar">
                        <span class="linkComoComprarIcone" aria-hidden="true">i</span>
                        <span>Como funciona a compra?</span>
                        <span class="linkComoComprarSeta" aria-hidden="true">&rarr;</span>
                    </a>
                </div>
 
            </div>
        </div>
    </section>
    
     <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js" defer></script>
     <script src="/js/pages/carrinho-integrado.js" defer></script>

<%- include("../partials/footer") %>
