<%- include("../partials/head") %>

  <link rel="stylesheet" href="/css/pages/catalogo.css">

  <%- include("../partials/header") %>
<main>
  <div class="page-container">
    <form method="get" action="/catalogo">

      <input type="hidden" name="q" value="<%= filtros.busca || '' %>">

      <div class="title-bar">
        <div>
          <h1>Catálogo</h1>
          <p class="prod-count">Produtos encontrados (<%= produtos.length %>)</p>
          <% if (filtros.busca) { %>
            <p>Busca por: "<%= filtros.busca %>" &nbsp;<a href="/catalogo">limpar</a></p>
          <% } %>
        </div>
        <div class="sort-area">
          <span>Ordenar por</span>
          <select name="ordenar" onchange="this.form.submit()">
            <option value="">Nome (A-Z)</option>
            <option value="menor" <%= filtros.ordenar === 'menor' ? 'selected' : '' %>>Menor preço</option>
            <option value="maior" <%= filtros.ordenar === 'maior' ? 'selected' : '' %>>Maior preço</option>
          </select>
        </div>
      </div>

      <div class="breadcrumb">
        <a href="/">Início</a>
        <span class="sep">›</span>
        <span>Catálogo</span>
      </div>

      <!-- Sidebar + Grid -->
      <div class="content-row">

        <!-- ══ SIDEBAR ══ -->
        <aside class="sidebar">

          <!-- Categoria (vem da tabela categoria) -->
          <div class="filter-group">
            <div class="filter-title open">
              Categoria
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                stroke-width="2.5" stroke="currentColor">
                <path stroke-linecap="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/>
              </svg>
            </div>
            <div class="filter-body">
              <label class="filter-check">
                <input type="radio" name="categoria" value="" <%= !filtros.categoria ? 'checked' : '' %>> Todas
              </label>
              <% categorias.forEach(function (categoria) { %>
                <label class="filter-check">
                  <input type="radio" name="categoria" value="<%= categoria.id_categoria %>"
                    <%= String(categoria.id_categoria) === filtros.categoria ? 'checked' : '' %>>
                  <%= categoria.nome %>
                </label>
              <% }) %>
            </div>
          </div>

          <!-- Marca (vem da tabela marca) -->
          <div class="filter-group">
            <div class="filter-title open">
              Marca
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                stroke-width="2.5" stroke="currentColor">
                <path stroke-linecap="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/>
              </svg>
            </div>
            <div class="filter-body">
              <label class="filter-check">
                <input type="radio" name="marca" value="" <%= !filtros.marca ? 'checked' : '' %>> Todas
              </label>
              <% marcas.forEach(function (marca) { %>
                <label class="filter-check">
                  <input type="radio" name="marca" value="<%= marca.id_marca %>"
                    <%= String(marca.id_marca) === filtros.marca ? 'checked' : '' %>>
                  <%= marca.nome %>
                </label>
              <% }) %>
            </div>
          </div>

          <button type="submit" class="btn-filtrar">Filtrar</button>

        </aside>

        <div class="products-area">
          <div class="products-grid" id="productsGrid">

            <% if (produtos.length === 0) { %>
              <p>Nenhum produto encontrado com esses filtros.</p>
            <% } %>

            <% produtos.forEach(function (produto) { %>
              <% const preco = String(produto.preco_produto).split('.') %>
              <a class="product-card" href="/produto/<%= produto.sku %>">
                <img src="<%= produto.imagem || '/img/icons/icons8-caixa-128.png' %>" alt="<%= produto.titulo_produto %>">

                <div class="product-info">
                  <p class="product-name"><%= produto.titulo_produto %></p>
                  <p><%= produto.marca %></p>
                  <h3>R$ <%= preco[0] %><span>,<%= preco[1] %></span></h3>
                  <button type="button">Adicionar ao carrinho</button>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
      </div>
    </form>
  </div>
</main>

<script src="/js/pages/catalogo.js"></script>

<%- include("../partials/footer") %>
