<%- include("../partials/head", { tituloPagina: 'Catálogo' }) %>

  <link rel="stylesheet" href="/css/pages/catalogo.css">

  <%- include("../partials/header") %>
<main>
  <div class="page-container">

    <!-- Formulário de filtros: ao enviar, o navegador vai para /catalogo?categoria=...&marca=...&ordenar=...
         O catalogo.js repassa esses mesmos parâmetros para a API /api/produtos, que faz a consulta no MySQL. -->
    <form method="get" action="/catalogo">

      <!-- Mantém a busca do header quando o usuário muda um filtro -->
      <input type="hidden" name="q" value="<%= filtros.busca || '' %>">

      <!-- Barra de título + ordenação -->
      <div class="title-bar">
        <div>
          <h1>Produtos</h1>
          <p class="prod-count">Carregando produtos...</p>
        </div>
        <div class="sort-area">
          <span>Ordenar por</span>
          <select name="ordenar" onchange="this.form.submit()">
            <option value="">Nome (A-Z)</option>
            <option value="menor" <%= filtros.ordenar === 'menor' ? 'selected' : '' %>>Menor preço</option>
            <option value="maior" <%= filtros.ordenar === 'maior' ? 'selected' : '' %>>Maior preço</option>
          </select>
        </div>
      </div>

      <!-- Breadcrumb -->
      <div class="breadcrumb">
        <a href="/">Início</a>
        <span class="sep">›</span>
        <span>Catálogo</span>
      </div>

      <!-- Filtros ativos: preenchido pelo catalogo.js (etiquetas com ✕ para remover cada filtro) -->
      <div class="filtros-ativos" id="filtrosAtivos" hidden></div>

      <!-- Sidebar + Grid -->
      <div class="content-row">

        <!-- ══ SIDEBAR ══ -->
        <aside class="sidebar">

          <!-- Categoria: a lista vem do middleware navbar (navbarCategorias) -->
          <div class="filter-group">
            <div class="filter-title open">
              Categoria
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                stroke-width="2.5" stroke="currentColor">
                <path stroke-linecap="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/>
              </svg>
            </div>
            <div class="filter-body">
              <select class="filtro-classificacao" name="categoria" aria-label="Categoria" data-categoria-select>
                <option value="">Todas as categorias</option>
                <% navbarCategorias.forEach(function (categoria) { %><option value="<%= categoria.id_categoria %>"<%= String(categoria.id_categoria) === filtros.categoria ? ' selected' : '' %>><%= categoria.nome %></option><% }) %>
              </select>
              <label for="filtro-subcategoria">Subcategoria</label>
              <select class="filtro-classificacao" id="filtro-subcategoria" name="subcategoria" data-subcategoria-select data-todas-sem-categoria="sim">
                <option value="">Todas as subcategorias</option>
                <% navbarCategorias.forEach(function (categoria) { categoria.subcategorias.forEach(function (sub) { %><option data-categoria="<%= categoria.id_categoria %>" value="<%= sub.id_subcategoria %>"<%= String(sub.id_subcategoria) === filtros.subcategoria ? ' selected' : '' %>><%= sub.nome %></option><% }) }) %>
              </select>
            </div>
          </div>

          <!-- Marca: a lista vem da rota /catalogo (routes/loja.js) -->
          <div class="filter-group">
            <div class="filter-title open">
              Marca
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                stroke-width="2.5" stroke="currentColor">
                <path stroke-linecap="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/>
              </svg>
            </div>
            <div class="filter-body">
              <label class="filter-check">
                <input type="radio" name="marca" value="" <%= !filtros.marca ? 'checked' : '' %>> Todas
              </label>
              <% marcas.forEach(function (marca) { %>
                <label class="filter-check">
                  <input type="radio" name="marca" value="<%= marca.id_marca %>"
                    <%= String(marca.id_marca) === filtros.marca ? 'checked' : '' %>>
                  <%= marca.nome %>
                </label>
              <% }) %>
            </div>
          </div>

          <button type="submit" class="btn-filtrar">Filtrar</button>

        </aside>
        <!-- /sidebar -->

        <!-- ══ GRID DE PRODUTOS ══ (preenchido pelo catalogo.js com os dados da API) -->
        <div class="products-area">
          <div class="products-grid" id="productsGrid"></div>
        </div>
        <!-- /products-area -->

      </div>
      <!-- /content-row -->

    </form>

  </div>
  <!-- /page-container -->
</main>

<script src="/js/pages/filtro-categorias.js"></script>
<script src="/js/pages/catalogo.js"></script>

<%- include("../partials/footer") %>