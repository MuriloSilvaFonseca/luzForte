<%- include("../partials/head") %>
    <link rel="stylesheet" href="/css/base/reset.css">
    <link rel="stylesheet" href="/css/pages/produto.css">

    <%- include("../partials/header") %>

    <div class="container_produto">
        <div class="breadcrumb_produto" id="breadcrumbProduto"></div>

        <div class="product_section_produto">
            <div class="gallery_produto">
                <div class="main_image_produto" id="mainImage">
                    <img src="" alt="">
                </div>
                <div class="thumbnails_produto" id="thumbnailsProduto"></div>
            </div>

            <div class="product_info_produto">
                <p class="classification_label_produto" id="classificationLabel"></p>

                <h1 id="productName"></h1>
                <p class="product_code_produto" id="productCode"></p>

                <div class="rating_produto">
                    <div class="stars_produto" id="productStars"></div>
                    <span class="reviews_produto" id="productReviews"></span>
                </div>

                <div class="stock_produto">
                    <img src="/img/icons/icons8-caixa-128.png" alt="">
                    <p id="productStock"></p>
                </div>

                <div class="price_section_produto">
                    <p class="old_price_produto" id="productOldPrice"></p>
                    <p class="current_price_produto" id="productCurrentPrice"></p>
                    <p class="installments_produto" id="productInstallments"></p>
                </div>

                <div class="quantity_section_produto">
                    <div class="quantity_control_produto">
                        <button class="quantity_btn_produto" onclick="decrementQuantity()">−</button>
                        <input type="number" id="quantity" class="quantity_input_produto" value="1" min="1" max="99">
                        <button class="quantity_btn_produto" onclick="incrementQuantity()">+</button>
                    </div>
                </div>

                <div class="action_buttons_produto">
                    <button class="btn_produto btn_primary_produto" onclick="addToCart()">Adicionar ao Carrinho</button>
                    <button class="btn_produto btn_secondary_produto" onclick="buyNow()">Comprar Agora</button>
                </div>
            </div>
        </div>

        <div class="tabs_produto">
            <div class="tab_buttons_produto">
                <button class="tab_btn_produto active_produto" data-tab="description">Descrição</button>
                <button class="tab_btn_produto" data-tab="specs">Especificações Técnicas</button>
                <button class="tab_btn_produto" data-tab="installation">Instalação</button>
            </div>

            <div id="description" class="tab_content_produto active_produto"></div>
            <div id="specs" class="tab_content_produto"></div>
            <div id="installation" class="tab_content_produto"></div>
        </div>
    </div>

    <div class="notification_produto" id="notification">
        ✓ Produto adicionado ao carrinho!
    </div>

    <script src="/js/pages/produto.js"></script>
<%- include("../partials/footer") %>
