<%- include("../partials/head", { tituloPagina: 'Produto' }) %>
    <link rel="stylesheet" href="/css/base/reset.css">
    <link rel="stylesheet" href="/css/pages/produto.css">

    <%- include("../partials/header") %>

    <div class="container_produto">
        <div class="breadcrumb_produto" id="breadcrumbProduto"></div>

        <div class="product_section_produto">
            <div class="gallery_produto">
                <div class="main_image_produto" id="mainImage">
                    <img src="" alt="">
                </div>
                <div class="thumbnails_produto" id="thumbnailsProduto"></div>
            </div>

            <div class="product_info_produto">
                <p class="classification_label_produto" id="classificationLabel"></p>

                <h1 id="productName"></h1>
                <p class="product_code_produto" id="productCode"></p>

                <div class="rating_produto">
                    <div class="stars_produto" id="productStars"></div>
                    <span class="reviews_produto" id="productReviews"></span>
                </div>

                <div class="stock_produto">
                    <img src="/img/icons/icons8-caixa-128.png" alt="">
                    <p id="productStock"></p>
                </div>

                <div class="price_section_produto">
                    <p class="old_price_produto" id="productOldPrice"></p>
                    <p class="current_price_produto" id="productCurrentPrice"></p>
                    <p class="installments_produto" id="productInstallments"></p>
                </div>

                <div class="quantity_section_produto">
                    <div class="quantity_control_produto">
                        <button class="quantity_btn_produto" onclick="decrementQuantity()">−</button>
                        <input type="number" id="quantity" class="quantity_input_produto" value="1" min="1" max="99">
                        <button class="quantity_btn_produto" onclick="incrementQuantity()">+</button>
                    </div>
                </div>

                <div class="action_buttons_produto">
                    <button class="btn_produto btn_primary_produto" onclick="addToCart()">Adicionar ao Carrinho</button>
                    <button class="btn_produto btn_secondary_produto" onclick="buyNow()">Comprar Agora</button>
                </div>
            </div>
        </div>

        <div class="tabs_produto">
            <div class="tab_buttons_produto">
                <button class="tab_btn_produto active_produto" data-tab="description">Descrição</button>
                <button class="tab_btn_produto" data-tab="specs">Especificações Técnicas</button>
                <button class="tab_btn_produto" data-tab="installation">Instalação</button>
            </div>

            <div id="description" class="tab_content_produto active_produto"></div>
            <div id="specs" class="tab_content_produto"></div>
            <div id="installation" class="tab_content_produto"></div>
        </div>

        <section class="avaliacoes_produto" id="avaliacoes" aria-labelledby="avaliacoesTitulo">
    <h2 class="avaliacoes_titulo_produto" id="avaliacoesTitulo">Opiniões do produto</h2>

       <div class="avaliacoes_card_produto">
        <div class="avaliacoes_resumo_produto" id="avaliacoesResumo"></div>
        <div class="avaliacoes_lista_produto" id="avaliacoesLista"></div>
    </div>
    <div class="avaliar_produto" id="avaliar">
    <h3 class="avaliar_titulo_produto">Deixe sua avaliação</h3>

    <% if (locals.usuario) { %>
        <form class="avaliar_form_produto" id="formAvaliar" action="/avaliacoes" method="post">
            <input type="hidden" name="sku" id="avaliacaoSku">

            <fieldset class="avaliar_nota_produto">
                <legend class="avaliar_label_produto">Sua nota <span class="avaliar_obrigatorio_produto">*</span></legend>
                <div class="avaliar_estrelas_produto">
                    <input type="radio" id="nota5" name="nota" value="5" required>
                    <label for="nota5"><span class="avaliar_sr_produto">5 estrelas</span>★</label>
                    <input type="radio" id="nota4" name="nota" value="4">
                    <label for="nota4"><span class="avaliar_sr_produto">4 estrelas</span>★</label>
                    <input type="radio" id="nota3" name="nota" value="3">
                    <label for="nota3"><span class="avaliar_sr_produto">3 estrelas</span>★</label>
                    <input type="radio" id="nota2" name="nota" value="2">
                    <label for="nota2"><span class="avaliar_sr_produto">2 estrelas</span>★</label>
                    <input type="radio" id="nota1" name="nota" value="1">
                    <label for="nota1"><span class="avaliar_sr_produto">1 estrela</span>★</label>
                </div>
            </fieldset>

            

            <div class="avaliar_campo_produto">
                <label class="avaliar_label_produto" for="avaliacaoTexto">Seu comentário <span class="avaliar_obrigatorio_produto">*</span></label>
                <textarea class="avaliar_input_produto avaliar_textarea_produto" id="avaliacaoTexto" name="texto"
                          rows="4" minlength="10" maxlength="500" required
                          placeholder="Conte como foi sua experiência com o produto"></textarea>
                <span class="avaliar_contador_produto" id="avaliacaoContador">0/500</span>
            </div>

            <div class="avaliar_rodape_produto">
                <p class="avaliar_aviso_produto">Sua avaliação será publicada após análise da nossa equipe.</p>
                <button class="btn_produto btn_primary_produto avaliar_botao_produto" type="submit">Enviar avaliação</button>
            </div>

            <p class="avaliar_mensagem_produto" id="avaliacaoMensagem" role="status" hidden>
                ✓ Obrigado! Recebemos sua avaliação e ela será publicada após análise.
            </p>
        </form>
    <% } else { %>
        <p class="avaliar_aviso_produto">
            Para avaliar este produto, <a class="avaliar_link_produto" href="/login">entre na sua conta</a>.
        </p>
    <% } %>
</div>
</section>


    </div>



    <div class="notification_produto" id="notification">
        ✓ Produto adicionado ao carrinho!
    </div>
    

    <script src="/js/pages/produto.js"></script>
<%- include("../partials/footer") %>
