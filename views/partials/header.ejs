    </head>
<body>

 

  <!-- Cabeçalho -->
    <header>
        

        <div class="container-auto">

          <div class="caixas">
            <div class="top-bar"></div>
            <div class="header"></div>
            <div class="navegacao"></div>
          </div>



            <div class="container-menu">
                <div class="top-bar">
                    <div class="top-item">
                        <img src="/img/icons/icons8-localização-50.png" alt="Localização" class="icon">
                        <span>Entrega para São João da Boa Vista</span>
                    </div>

                </div>
                <div class="header">
                    <!-- Logo -->
                    <div class="logo">
                        <a href="/"><img class="logo-highlight" src="/img/logos/logo2.png" alt=""></a>
                    </div>

                    <!-- Busca -->
                    <!-- A busca envia para /catalogo?q=... -->
                    <form class="search" method="get" action="/catalogo">
                        <input type="text" name="q" placeholder="    Buscar produtos..." class="search-input">
                        <button type="submit" class="search-button">
                            <img src="/img/icons/icons8-pesquisar-50.png" alt="Buscar" class="icon">
                        </button>
                    </form>

                    <!-- Usuário -->
                    <div class="user">
                        <a href="/login">
                            <img classe="it" src="/img/icons/icons8-usuário-homem-com-círculo-48.png"
                            alt="Usuário" class="icon">
                        <span><%= usuario ? 'Olá, ' + usuario.nome_usuario : 'Entre na sua conta' %></span>
                        </a>
                    </div>

                    <!-- Carrinho -->
                    <div class="cart">
                        <a href="/carrinho">
                            <img src="/img/icons/icons8-carrinho-de-compras-30.png" alt="Carrinho"
                            class="icon">
                            <span class="cart-badge"></span>
                        </a>
                    </div>
                </div>

                <!-- Categorias carregadas do MySQL -->
                <nav class="navegacao barra-categorias" aria-label="Navegação principal">
                    <details class="menu-suspenso todas-categorias">
                        <summary class="botao-categorias">&#9776; Categorias</summary>
                        <ul class="painel-menu lista-categorias">
                            <% navbarCategorias.forEach(categoria => { %>
                                <li>
                                    <details class="menu-suspenso categoria-submenu">
                                        <summary><%= categoria.nome %> <span aria-hidden="true">&rsaquo;</span></summary>
                                        <ul class="painel-menu painel-lateral">
                                            <li><a href="/catalogo?categoria=<%= categoria.id_categoria %>">Ver categoria</a></li>
                                            <% categoria.subcategorias.forEach(sub => { %>
                                                <li><a href="/catalogo?subcategoria=<%= sub.id_subcategoria %>"><%= sub.nome %></a></li>
                                            <% }) %>
                                        </ul>
                                    </details>
                                </li>
                            <% }) %>
                            <% if (!navbarCategorias.length) { %>
                                <li class="menu-vazio"><%= navbarIndisponivel ? 'Categorias indisponíveis no momento.' : 'Nenhuma categoria cadastrada.' %></li>
                            <% } %>
                        </ul>
                    </details>
                    <div class="links-menu">
                        <% if (navbarIndisponivel) { %>
                            <span class="aviso-categorias" role="status">Categorias temporariamente indisponíveis.</span>
                        <% } %>
                        <% navbarPrincipais.forEach(categoria => { %>
                            <details class="menu-suspenso categoria-principal">
                                <summary class="link-menu"><%= categoria.nome %></summary>
                                <ul class="painel-menu">
                                    <li><a href="/catalogo?categoria=<%= categoria.id_categoria %>">Ver categoria</a></li>
                                    <% categoria.subcategorias.forEach(sub => { %>
                                        <li><a href="/catalogo?subcategoria=<%= sub.id_subcategoria %>"><%= sub.nome %></a></li>
                                    <% }) %>
                                </ul>
                            </details>
                        <% }) %>
                        <a href="/sobre-nos" class="link-menu">Sobre nós</a>
                    </div>
                </nav>
            </div>

            <div class="caixas">
            <div class="top-bar"></div>
            <div class="header"></div>
            <div class="navegacao"></div>
          </div>





        </div>
    </header>
    <script src="/js/modules/navbar.js" defer></script>
    <script src="/js/modules/carrinho-api.js" defer></script>
