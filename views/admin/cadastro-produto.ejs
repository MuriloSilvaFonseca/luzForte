<%
  const emEdicao = Boolean(locals.editando)
  const mensagemErro = locals.erro || ''
  const produtoSalvo = Boolean(locals.salvo)
  const listaMarcas = locals.marcas || []
  const listaSubcategorias = locals.subcategorias || []
  const valoresFormulario = locals.valores || {}
  const acaoFormulario = emEdicao ? '/admin/produtos/' + valoresFormulario.sku + '/editar' : '/admin/produtos/novo'
%>

<%- include('../partials/admin/admin-topo', { pagina: emEdicao ? 'produtos' : 'cadastro', titulo: emEdicao ? 'Editar produto' : 'Cadastro de produto' }) %>

<nav class="adm-breadcrumb" aria-label="Você está em">
  <a href="/admin">Administração</a>
  <a href="/admin/produtos">Produtos</a>
  <span><%= emEdicao ? 'Edição' : 'Cadastro' %></span>
</nav>

<div class="adm-pagehead">
  <div>
    <h1><%= emEdicao ? 'Editar produto' : 'Cadastrar produto' %></h1>
    <p><%= emEdicao ? 'Atualize as informações e salve as alterações.' : 'Preencha as informações para adicionar um produto ao catálogo.' %></p>
  </div>
  <span class="admin-produto-aviso"><span class="admin-produto-obrigatorio">*</span> Campos obrigatórios</span>
</div>

<% if (mensagemErro) { %>
  <p class="admin-produto-mensagem admin-produto-mensagem-erro" role="alert"><%= mensagemErro %></p>
<% } %>
<% if (produtoSalvo) { %>
  <p class="admin-produto-mensagem admin-produto-mensagem-sucesso" role="status"><%= emEdicao ? 'Produto atualizado com sucesso.' : 'Produto cadastrado com sucesso.' %></p>
<% } %>

<form class="admin-produto-formulario" action="<%= acaoFormulario %>" method="post" enctype="multipart/form-data">

  <!-- 1. Identificação -->
  <section class="admin-produto-secao" aria-labelledby="admin-produto-identificacao">
    <div class="admin-produto-secao-cabecalho">
      <span class="admin-produto-numero" aria-hidden="true">1</span>
      <div>
        <h2 class="admin-produto-secao-titulo" id="admin-produto-identificacao">Identificação</h2>
        <p class="admin-produto-secao-texto">Informações principais para reconhecer o produto.</p>
      </div>
    </div>

    <div class="admin-produto-grade">
      <div class="admin-produto-campo admin-produto-campo-largo">
        <label class="admin-produto-label" for="titulo-produto">Nome do produto <span class="admin-produto-obrigatorio">*</span></label>
        <input class="admin-produto-input" id="titulo-produto" name="titulo_produto" type="text" maxlength="70" value="<%= valoresFormulario.titulo_produto || '' %>" placeholder="Ex.: Lâmpada LED 9W branca" required>
        <small class="admin-produto-ajuda">Máximo de 70 caracteres.</small>
      </div>

      <div class="admin-produto-campo">
        <label class="admin-produto-label" for="sku-produto">SKU <span class="admin-produto-obrigatorio">*</span></label>
        <input class="admin-produto-input" id="sku-produto" name="sku" type="number" min="1" max="2147483647" step="1" value="<%= valoresFormulario.sku || '' %>" placeholder="Ex.: 1001" aria-describedby="sku-ajuda"<%= emEdicao ? ' readonly' : '' %> required>
        <small class="admin-produto-ajuda" id="sku-ajuda"><%= emEdicao ? 'O SKU é fixo para manter os vínculos com pedidos e avaliações.' : 'Código definido conforme o banco atual.' %></small>
      </div>

      <div class="admin-produto-campo">
        <label class="admin-produto-label" for="ean-produto">Código de barras (EAN)</label>
        <input class="admin-produto-input" id="ean-produto" name="GTIN_EAN" type="text" maxlength="14" value="<%= valoresFormulario.GTIN_EAN || '' %>" placeholder="Opcional">
      </div>

      <fieldset class="admin-produto-campo admin-produto-status">
        <legend class="admin-produto-label">Status do produto</legend>
        <label class="admin-produto-opcao"><input type="radio" name="ativo" value="ativo"<%= !valoresFormulario.ativo || valoresFormulario.ativo === 'ativo' ? ' checked' : '' %>> Ativo</label>
        <label class="admin-produto-opcao"><input type="radio" name="ativo" value="desativado"<%= valoresFormulario.ativo === 'desativado' ? ' checked' : '' %>> Desativado</label>
        <label class="admin-produto-opcao"><input type="radio" name="ativo" value="oculto"<%= valoresFormulario.ativo === 'oculto' ? ' checked' : '' %>> Oculto</label>
      </fieldset>
    </div>
  </section>

  <!-- 2. Classificação -->
  <section class="admin-produto-secao" aria-labelledby="admin-produto-classificacao">
    <div class="admin-produto-secao-cabecalho">
      <span class="admin-produto-numero" aria-hidden="true">2</span>
      <div>
        <h2 class="admin-produto-secao-titulo" id="admin-produto-classificacao">Classificação</h2>
        <p class="admin-produto-secao-texto">Organize o produto para facilitar a busca na loja.</p>
      </div>
    </div>

    <div class="admin-produto-grade">
      <div class="admin-produto-campo">
        <label class="admin-produto-label" for="marca-produto">Marca <span class="admin-produto-obrigatorio">*</span></label>
        <select class="admin-produto-input" id="marca-produto" name="marca_id" required>
          <option value="">Selecione uma marca</option>
          <% listaMarcas.forEach(function (marca) { %>
            <option value="<%= marca.id %>"<%= String(valoresFormulario.marca_id) === String(marca.id) ? ' selected' : '' %>><%= marca.nome %></option>
          <% }) %>
        </select>
      </div>

      <div class="admin-produto-campo">
        <label class="admin-produto-label" for="subcategoria-produto">Categoria e subcategoria <span class="admin-produto-obrigatorio">*</span></label>
        <select class="admin-produto-input" id="subcategoria-produto" name="subcategoria_id" required>
          <option value="">Selecione uma subcategoria</option>
          <% listaSubcategorias.forEach(function (subcategoria) { %>
            <option value="<%= subcategoria.id %>"<%= String(valoresFormulario.subcategoria_id) === String(subcategoria.id) ? ' selected' : '' %>><%= subcategoria.nome %></option>
          <% }) %>
        </select>
      </div>
    </div>
  </section>

  <!-- 3. Preço e estoque -->
  <section class="admin-produto-secao" aria-labelledby="admin-produto-valores">
    <div class="admin-produto-secao-cabecalho">
      <span class="admin-produto-numero" aria-hidden="true">3</span>
      <div>
        <h2 class="admin-produto-secao-titulo" id="admin-produto-valores">Preço e estoque</h2>
        <p class="admin-produto-secao-texto">Informe os valores e a quantidade disponível.</p>
      </div>
    </div>

    <div class="admin-produto-grade admin-produto-grade-tres">
      <div class="admin-produto-campo">
        <label class="admin-produto-label" for="custo-produto">Custo (R$) <span class="admin-produto-obrigatorio">*</span></label>
        <input class="admin-produto-input" id="custo-produto" name="custo_produto" type="number" min="0" max="99999999.99" step="0.01" value="<%= valoresFormulario.custo_produto ?? '' %>" placeholder="0,00" required>
      </div>

      <div class="admin-produto-campo">
        <label class="admin-produto-label" for="preco-produto">Preço de venda (R$) <span class="admin-produto-obrigatorio">*</span></label>
        <input class="admin-produto-input" id="preco-produto" name="preco_produto" type="number" min="0" max="99999999.99" step="0.01" value="<%= valoresFormulario.preco_produto ?? '' %>" placeholder="0,00" required>
      </div>

      <div class="admin-produto-campo">
        <label class="admin-produto-label" for="estoque-produto">Estoque (unidades)</label>
        <input class="admin-produto-input" id="estoque-produto" name="estoque_produto" type="number" min="0" max="2147483647" step="1" value="<%= valoresFormulario.estoque_produto ?? '0' %>">
      </div>
    </div>
  </section>

  <!-- 4. Detalhes -->
  <section class="admin-produto-secao" aria-labelledby="admin-produto-detalhes">
    <div class="admin-produto-secao-cabecalho">
      <span class="admin-produto-numero" aria-hidden="true">4</span>
      <div>
        <h2 class="admin-produto-secao-titulo" id="admin-produto-detalhes">Detalhes do produto</h2>
        <p class="admin-produto-secao-texto">Essas informações ajudam o cliente a conhecer o produto.</p>
        <% if (emEdicao) { %>
          <p class="admin-produto-ajuda">Se houver vários registros, você edita o primeiro de cada tipo. Os demais são mantidos.</p>
        <% } %>
      </div>
    </div>

    <div class="admin-produto-grade">
      <div class="admin-produto-campo">
        <label class="admin-produto-label" for="descricao-produto">Descrição<%= emEdicao && valoresFormulario.nome_descricao ? ' — ' + valoresFormulario.nome_descricao : '' %></label>
        <textarea class="admin-produto-input admin-produto-textarea" id="descricao-produto" name="descricao" rows="4" placeholder="Descreva o produto"><%= valoresFormulario.descricao || '' %></textarea>
      </div>

      <div class="admin-produto-campo">
        <label class="admin-produto-label" for="especificacao-produto">Especificações<%= emEdicao && valoresFormulario.nome_especificacao ? ' — ' + valoresFormulario.nome_especificacao : '' %></label>
        <textarea class="admin-produto-input admin-produto-textarea" id="especificacao-produto" name="especificacao" rows="4" placeholder="Ex.: potência, cor, tensão"><%= valoresFormulario.especificacao || '' %></textarea>
      </div>

      <div class="admin-produto-campo admin-produto-campo-largo">
        <label class="admin-produto-label" for="instalacao-produto">Orientações de instalação<%= emEdicao && valoresFormulario.nome_instalacao ? ' — ' + valoresFormulario.nome_instalacao : '' %></label>
        <textarea class="admin-produto-input admin-produto-textarea" id="instalacao-produto" name="instalacao" rows="3" placeholder="Orientações de uso ou instalação, se houver"><%= valoresFormulario.instalacao || '' %></textarea>
      </div>
    </div>
  </section>

  <!-- 5. Imagens -->
  <section class="admin-produto-secao" aria-labelledby="admin-produto-imagem">
    <div class="admin-produto-secao-cabecalho">
      <span class="admin-produto-numero" aria-hidden="true">5</span>
      <div>
        <h2 class="admin-produto-secao-titulo" id="admin-produto-imagem">Imagens do produto</h2>
        <p class="admin-produto-secao-texto">Envie até 5 imagens para a galeria do produto.</p>
      </div>
    </div>

    <div class="admin-produto-campo">
      <% if (emEdicao && Array.isArray(valoresFormulario.imagens) && valoresFormulario.imagens.length) { %>
        <p class="admin-produto-label">Imagens atuais</p>
        <div class="admin-produto-imagens-atuais">
          <% valoresFormulario.imagens.forEach(function (imagem) { %>
            <figure class="admin-produto-imagem-atual">
              <img src="<%= imagem.url %>" alt="Imagem <%= imagem.ordem %> de <%= valoresFormulario.titulo_produto || 'produto' %>" loading="lazy">
              <figcaption>Imagem <%= imagem.ordem %></figcaption>
            </figure>
          <% }) %>
        </div>
        <small class="admin-produto-ajuda">Enviar novas imagens substituirá as atuais. Se não selecionar arquivos, as imagens atuais serão mantidas.</small>
      <% } %>
      <label class="admin-produto-label" for="imagens-produto">Selecionar imagens</label>
      <input class="admin-produto-input admin-produto-input-arquivo" id="imagens-produto" name="imagens" type="file" accept="image/jpeg,image/png,image/webp" multiple data-max-arquivos="5">
      <small class="admin-produto-ajuda" id="imagens-produto-ajuda">PNG, JPG ou WebP; até 5 imagens de no máximo 5 MB cada.</small>
    </div>
  </section>

  <!-- Ações -->
  <div class="admin-produto-acoes">
    <span class="admin-produto-rascunho">Os campos marcados com * são obrigatórios.</span>
    <div class="admin-produto-botoes">
      <a class="admin-produto-botao" href="/admin/produtos">Cancelar</a>
      <button class="admin-produto-botao admin-produto-botao-principal" type="submit"><%= emEdicao ? 'Salvar alterações' : 'Salvar produto' %></button>
    </div>
  </div>

</form>

<%- include('../partials/admin/admin-rodape', { scripts: ['/js/pages/admin-produto-imagens.js'] }) %>
