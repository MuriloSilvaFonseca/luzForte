<%- include('../partials/admin/admin-topo', { pagina: 'visao-geral', titulo: 'Visão geral' }) %>

<%
  const moeda = (v) => 'R$ ' + Number(v || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 })
%>

<link rel="stylesheet" href="/css/pages/admin-gestao.css">
<nav class="adm-breadcrumb" aria-label="Você está em">
  <a href="/admin">Administração</a>
  <span>Visão geral</span>
</nav>

<div class="adm-pagehead">
  <div>
    <h1>Visão geral</h1>
    <p>Resumo da loja e pendências que precisam da sua atenção.</p>
  </div>
  <a class="adm-btn adm-btn--primary" href="/admin/produtos/novo">+ Cadastrar produto</a>
</div>

<section class="adm-card admin-dashboard-financeiro" aria-labelledby="dashboard-faturamento">
  <div class="admin-dashboard-financeiro__principal">
    <h2 id="dashboard-faturamento">Faturamento</h2>
    <p class="admin-dashboard-financeiro__valor"><%= moeda(financeiro.faturamento) %></p>
    <p class="admin-dashboard-financeiro__nota">Todo o período · Pedidos aprovados e retirados</p>
    <p class="admin-dashboard-financeiro__nota">Solicitados, cancelados e carrinhos não entram no faturamento.</p>
  </div>
  <dl class="admin-dashboard-financeiro__status">
    <% financeiro.indicadores.forEach(function (item) { %>
      <div>
        <dt><%= item.nome %></dt>
        <dd>
          <% if (item.tipo === 'moeda') { %><%= moeda(item.valor) %>
          <% } else if (item.tipo === 'porcentagem') { %><%= item.valor.toLocaleString('pt-BR', { maximumFractionDigits: 1 }) %>%
          <% } else { %><%= item.valor %><% } %>
        </dd>
      </div>
    <% }) %>
  </dl>
</section>
<div class="adm-grid-2 admin-dashboard-pedidos">
  <% grupos.forEach(function (grupo) { %><%- include('../partials/admin/resumo-pedidos', { grupo, moeda }) %><% }) %>
</div>
<section class="adm-kpis admin-gestao-indicadores" aria-label="Indicadores">
  <article class="adm-card adm-kpi"><p class="adm-kpi__label">Pedidos hoje</p><p class="adm-kpi__value"><%= resumo.pedidosHoje %></p><p class="adm-kpi__hint">Pedidos registrados, sem carrinhos</p></article>
  <article class="adm-card adm-kpi"><p class="adm-kpi__label">Produtos ativos</p><p class="adm-kpi__value"><a href="/admin/produtos?status=ativo"><%= resumo.produtosAtivos %></a></p><p class="adm-kpi__hint">Disponíveis no catálogo</p></article>
  <article class="adm-card adm-kpi"><p class="adm-kpi__label">Usuários ativos</p><p class="adm-kpi__value"><a href="/admin/usuarios?situacao=ativo"><%= resumo.usuariosAtivos %></a></p><p class="adm-kpi__hint">Contas com acesso liberado</p></article>
  <article class="adm-card adm-kpi"><p class="adm-kpi__label">Estoque baixo</p><p class="adm-kpi__value"><a href="/admin/produtos?estoque=baixo&status=ativo"><%= resumo.estoqueBaixo %></a></p><p class="adm-kpi__hint">Produtos ativos com até 5 unidades</p></article>
</section>
<div class="admin-gestao-estoque">
  <section class="adm-card">
    <header class="adm-card__head">
      <h2>Estoque baixo</h2>
      <a href="/admin/produtos?estoque=baixo">Ver todos</a>
    </header>
    <% if (estoqueBaixoLista.length === 0) { %>
      <div class="adm-empty">Tudo em ordem por aqui.</div>
    <% } else { %>
      <ul class="adm-list">
        <% estoqueBaixoLista.forEach(function (p) { %>
          <li class="adm-list__item">
            <div>
              <p class="adm-list__title"><%= p.titulo %></p>
              <p class="adm-list__meta">SKU <%= p.sku %></p>
            </div>
            <span class="adm-list__value"><%= p.estoque %> un.</span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<%- include('../partials/admin/admin-rodape') %>
