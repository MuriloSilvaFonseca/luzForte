<%- include('../partials/admin/admin-topo', { pagina: 'usuarios', titulo: 'Usuários' }) %>

<%
  const perfis = {
    cliente: { rotulo: 'Cliente', cor: 'blue' },
    admin: { rotulo: 'Administrador', cor: 'yellow' }
  }
  const linkUsuarios = (pagina) => {
    const parametros = new URLSearchParams({ ...filtros, pagina })
    return '/admin/usuarios?' + parametros.toString()
  }
  const situacoes = {
    ativo: { rotulo: 'Ativo', cor: 'green' },
    desativado: { rotulo: 'Desativado', cor: 'red' }
  }
%>

<nav class="adm-breadcrumb" aria-label="Você está em">
  <a href="/admin">Administração</a>
  <span>Usuários</span>
</nav>

<div class="adm-pagehead">
  <div>
    <h1>Usuários</h1>
    <p><%= total %> usuário<%= total === 1 ? '' : 's' %> cadastrado<%= total === 1 ? '' : 's' %>.</p>
  </div>
</div>

<% if (salvo) { %><p class="adm-alert adm-alert--success" role="status">Situação da conta atualizada.</p><% } %>
<form class="adm-card adm-filters" method="get" action="/admin/usuarios">
  <input class="adm-field adm-field--search" type="search" name="q" value="<%= filtros.q %>" placeholder="Buscar por nome ou e-mail" aria-label="Buscar por nome ou e-mail">
  <select class="adm-field" name="perfil" aria-label="Perfil">
    <option value="">Todos os perfis</option>
    <% Object.keys(perfis).forEach(function (k) { %>
      <option value="<%= k %>"<%= filtros.perfil === k ? ' selected' : '' %>><%= perfis[k].rotulo %></option>
    <% }) %>
  </select>
  <select class="adm-field" name="situacao" aria-label="Situação">
    <option value="">Qualquer situação</option>
    <% Object.keys(situacoes).forEach(function (k) { %>
      <option value="<%= k %>"<%= filtros.situacao === k ? ' selected' : '' %>><%= situacoes[k].rotulo %></option>
    <% }) %>
  </select>
  <button class="adm-btn" type="submit">Filtrar</button>
</form>

<section class="adm-card">
  <div class="adm-tablewrap">
    <table class="adm-table">
      <thead>
        <tr>
          <th>Usuário</th>
          <th>Perfil</th>
          <th>Situação</th>
          <th>Cadastro</th>
          <th class="is-num">Pedidos</th>
          <th class="is-num">Avaliações</th>
          <th class="is-actions">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if (usuarios.length === 0) { %>
          <tr><td colspan="7"><div class="adm-empty"><strong>Nenhum usuário encontrado</strong>Tente outro filtro.</div></td></tr>
        <% } %>
        <% usuarios.forEach(function (u) {
          const pf = perfis[u.perfil] || perfis.cliente
          const sit = situacoes[u.situacao] || situacoes.ativo %>
          <tr>
            <td>
              <div class="adm-prod">
                <span class="adm-avatar" style="background:var(--adm-blue-bg);color:var(--adm-blue)"><%= u.nome.charAt(0).toUpperCase() %></span>
                <div>
                  <div class="adm-prod__name"><%= u.nome %></div>
                  <div class="adm-prod__sub"><%= u.email %></div>
                </div>
              </div>
            </td>
            <td><span class="adm-badge adm-badge--<%= pf.cor %>"><%= pf.rotulo %></span></td>
            <td><span class="adm-badge adm-badge--<%= sit.cor %>"><%= sit.rotulo %></span></td>
            <td><%= u.cadastro %></td>
            <td class="is-num"><%= u.pedidos %></td>
            <td class="is-num"><%= u.avaliacoes %></td>
            <td class="is-actions">
              <% if (u.perfil !== 'admin') { %>
                <form method="post" action="/admin/usuarios/<%= u.id %>/perfil" style="display:inline">
                  <input type="hidden" name="perfil" value="admin">
                  <button class="adm-btn adm-btn--sm adm-btn--icon adm-btn--icon-success" type="submit"
                          aria-label="Tornar <%= u.nome %> administrador" title="Tornar administrador">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="4"/><path d="M3 21v-2a6 6 0 0 1 6-6h2m6-1v8m-4-4h8"/></svg>
                  </button>
                </form>
              <% } else if (Number(u.id) !== Number(locals.usuario?.id_usuario)) { %>
                <form method="post" action="/admin/usuarios/<%= u.id %>/perfil" style="display:inline">
                  <input type="hidden" name="perfil" value="cliente">
                  <button class="adm-btn adm-btn--sm adm-btn--icon adm-btn--icon-danger" type="submit"
                          aria-label="Tornar <%= u.nome %> cliente" title="Tornar cliente">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="4"/><path d="M3 21v-2a6 6 0 0 1 6-6h2m2 2h8"/></svg>
                  </button>
                </form>
              <% } %>
              <a class="adm-btn adm-btn--sm adm-btn--icon adm-btn--icon-info" href="/admin/pedidos?usuario=<%= u.id %>&de=&ate=" aria-label="Ver histórico de pedidos de <%= u.nome %>" title="Histórico de pedidos">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5m4-1v5l3 2"/></svg>
              </a>


              <% if (u.perfil !== 'admin') { %>
                <form method="post" action="/admin/usuarios/<%= u.id %>/ativo">
                  <input type="hidden" name="ativo" value="<%= u.situacao === 'desativado' ? '1' : '0' %>">
                  <button class="adm-btn adm-btn--sm<%= u.situacao === 'desativado' ? '' : ' adm-btn--danger' %>" type="submit">
                    <%= u.situacao === 'desativado' ? 'Reativar conta' : 'Desativar conta' %>
                  </button>
                </form>
              <% } else { %><span>Conta protegida</span><% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="adm-pagination">
    <span>Página <%= pagina %> de <%= totalPaginas %></span>
    <nav aria-label="Paginação">
      <% if (pagina > 1) { %><a class="adm-btn adm-btn--sm" href="<%= linkUsuarios(pagina - 1) %>">Anterior</a><% } %>
      <% if (pagina < totalPaginas) { %><a class="adm-btn adm-btn--sm" href="<%= linkUsuarios(pagina + 1) %>">Próxima</a><% } %>
    </nav>
  </div>
</section>

<%- include('../partials/admin/admin-rodape') %>
