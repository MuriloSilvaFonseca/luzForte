<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuzForte | Registro</title>
    <link rel="icon" type="image/png" href="/img/faviconLuzForte.png">
    <link rel="stylesheet" href="/css/base/reset.css">
    <link rel="stylesheet" href="/css/pages/registro.css">
    <link rel="stylesheet" href="/css/components/footer.css">
    <script src="/js/pages/auth-forms.js" defer></script>
    
</head>
<body>
    <% const valoresRegistro = typeof valores !== 'undefined' ? valores : {} %>

    <header class="registro-header">
        <img class="registro-logo" src="/img/logos/logo.png" alt="LuzForte Logo">
    </header>

    <main class="registro-page">
        <div class="cadastro-container">
         <a class="cadastro-voltar" href="/login" aria-label="Voltar"><img src="/img/icons/de-volta.png" alt="Voltar"></a>
            <h1>Criar nova conta</h1>

            <form class="cadastro-form" action="/registro" method="post">
                <% if (typeof erro !== 'undefined' && erro) { %>
                    <p class="form-error" role="alert"><%= erro %></p>
                <% } %>
                <label class="field">
                    <span class="field-label">Nome completo*</span>
                    <input type="text" name="nome" placeholder="Digite seu nome completo" autocomplete="name" maxlength="200" value="<%= valoresRegistro.nome || '' %>" required>
                </label>

                <label class="field">
                    <span class="field-label">E-mail *</span>
                    <input type="email" name="email" placeholder="Digite seu e-mail" autocomplete="email" maxlength="255" value="<%= valoresRegistro.email || '' %>" required>
                </label>

                <label class="field">
                    <span class="field-label">Telefone*</span>
                    <input type="tel" name="telefone" placeholder="(00) 00000-0000" autocomplete="tel-national" inputmode="numeric" maxlength="15" data-mascara="telefone" value="<%= valoresRegistro.telefone || '' %>" required>
                </label>

                <div class="field password-field">
                    <label class="field-label" for="registro-senha">Senha*</label>
                    <div class="password-row">
                        <input type="password" id="registro-senha" name="senha" placeholder="Mínimo 8 caracteres" autocomplete="new-password" minlength="8" required>
                        <button type="button" class="show-pass" aria-label="Mostrar senha" aria-pressed="false"><img src="/img/icons/olho-fechado.png" alt=""></button>
                    </div>
                    <small class="hint">Sua senha deve ter no mínimo 8 caracteres</small>
                </div>

                <div class="field password-field">
                    <label class="field-label" for="registro-confirmar-senha">Confirmar Senha*</label>
                    <div class="password-row">
                        <input type="password" id="registro-confirmar-senha" name="confirm_senha" placeholder="Digite a senha novamente" autocomplete="new-password" minlength="8" required>
                        <button type="button" class="show-pass" aria-label="Mostrar senha" aria-pressed="false"><img src="/img/icons/olho-fechado.png" alt=""></button>
                    </div>
                </div>

                <button class="btn-cta" type="submit">Criar conta</button>

                <p class="terms">Ao clicar em Criar, você concorda com os Termos de Uso e a <a href="/politica-de-privacidade">Política de Privacidade</a>.</p>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>
