<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuzForte | Registro</title>
    <link rel="stylesheet" href="/css/base/reset.css">
    <link rel="stylesheet" href="/css/pages/registro.css">
    <link rel="stylesheet" href="/css/components/messages.css">
    <script src="/js/pages/auth-forms.js" defer></script>
    
</head>
<body>

    <header class="registro-header">
        <img class="registro-logo" src="/img/logos/logo.png" alt="LuzForte Logo">
    </header>

    <main class="registro-page">
        <div class="cadastro-container">
         <a class="cadastro-voltar" href="/login" aria-label="Voltar"><img src="/img/icons/de-volta.png" alt="Voltar"></a>
            <h1>Criar nova conta</h1>
            <button class="google-btn" type="button">
                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" width="20" height="20"
                        alt="Google" />
                    Continuar com o Google
                </button>
            <div class="divider"><span>OU</span></div>

            <form class="cadastro-form" action="/registro" method="post">
                <% if (typeof erro !== 'undefined') { %>
                    <p class="form-error" role="alert"><%= erro %></p>
                <% } %>
                <label class="field">
                    <span class="field-label">Nome completo*</span>
                    <input type="text" name="nome" placeholder="Digite seu nome completo" autocomplete="name" maxlength="200" required>
                </label>

                <label class="field">
                    <span class="field-label">E-mail *</span>
                    <input type="email" name="email" placeholder="Digite seu e-mail" autocomplete="email" maxlength="255" required>
                </label>

                <label class="field">
                    <span class="field-label">Telefone*</span>
                    <input type="tel" name="telefone" placeholder="(00) 00000-0000" autocomplete="tel-national" inputmode="numeric" maxlength="15" data-mascara="telefone" required>
                </label>

                <label class="field password-field">
                    <span class="field-label">Senha*</span>
                    <div class="password-row">
                        <input type="password" name="senha" placeholder="Mínimo 8 caracteres" autocomplete="new-password" minlength="8" required>
                        <button type="button" class="show-pass" aria-label="Mostrar senha" aria-pressed="false"><img src="/img/icons/olho-fechado.png" alt=""></button>
                    </div>
                    <small class="hint">Sua senha deve ter no mínimo 8 caracteres</small>
                </label>

                <label class="field password-field">
                    <span class="field-label">Confirmar Senha*</span>
                    <div class="password-row">
                        <input type="password" name="confirm_senha" placeholder="Digite a senha novamente" autocomplete="new-password" minlength="8" required>
                        <button type="button" class="show-pass" aria-label="Mostrar senha" aria-pressed="false"><img src="/img/icons/olho-fechado.png" alt=""></button>
                    </div>
                </label>

                <button class="btn-cta" type="submit">Criar conta</button>

                <p class="terms">Ao clicar em Criar, você concorda com os Termos de Uso e a Política de Privacidade.</p>
            </form>
        </div>
    </main>


    
   
</body>
</html>
