<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuzForte | Login</title>
    <link rel="icon" type="image/png" href="/img/faviconLuzForte.png">
    <!-- CSS -->
    <link rel="stylesheet" href="/css/base/reset.css">
    <link rel="stylesheet" href="/css/pages/login.css">
    <script src="/js/pages/auth-forms.js" defer></script>
</head>

<body>

    <div class="pagina-login-container">

        <div class="login-esquerdo"><img src="/img/banners/imagem banner login.png" alt=""></div>

        <div class="login-direito">

            <img class="login-logo" src="/img/logos/logo.png" alt="LuzForte Logo">

            <div class="login-container">

                <form id="login-form" method="post" action="/login">
                 <a class="cadastro-voltar" href="/" aria-label="Voltar"><img src="/img/icons/de-volta.png" alt="Voltar"></a>
                <h2>Acesse sua conta</h2>
                <% if (typeof erro !== 'undefined' && erro) { %>
                  <p class="form-error" role="alert"><%= erro %></p>
                <% } %>
                <div class="login-input">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="Digite seu e-mail" autocomplete="email" maxlength="255" required>
                </div>
                <div class="login-input">
                    <label for="password">Senha</label>
                    <div class="login-password-row">
                    <input type="password" id="password" name="password" placeholder="Digite sua senha" autocomplete="current-password" maxlength="256" required>
                        <button class="show-pass" type="button" aria-label="Mostrar senha" aria-pressed="false"><img src="/img/icons/olho-fechado.png" alt=""></button>
                    </div>
                    <a href="/esqueci-senha">Esqueceu sua senha?</a>
                </div>
                <button class="login-button" type="submit">Entrar</button>
                <p class="goCadastro">Não possui uma conta? <a href="/registro">Crie uma</a></p>
                </form>
            </div>
        </div>
    </div>

    
</body>

</html>
