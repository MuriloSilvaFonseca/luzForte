<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuzForte | Recuperar senha</title>
<!-- CSS -->
    <link rel="stylesheet" href="/css/base/reset.css">
    <link rel="stylesheet" href="/css/pages/forgot-password.css">
    <link rel="stylesheet" href="/css/components/messages.css">
</head>

<body>
    <main class="forgot-password-page">
        <div class="forgot-password-card">
            <a class="cadastro-voltar" href="/login" aria-label="Voltar">←</a>
            <img class="forgot-password-logo" src="/img/logos/logo.png" alt="LuzForte Logo">
            <h1>Recuperar senha</h1>

            <!-- A etapa vem da rota (routes/auth.js): email, codigo, nova-senha ou concluido -->

            <% if (erro) { %>
                <p class="redefinir-erro" role="alert"><%= erro %></p>
            <% } %>
            <% if (aviso) { %>
                <p class="redefinir-aviso"><%= aviso %></p>
            <% } %>

            <% if (etapa === 'email') { %>
                <p>Complete as etapas abaixo para redefinir sua senha com segurança.</p>
                <form class="forgot-password-form" action="/esqueci-senha" method="post">
                    <div class="step">
                        <h2>Digite seu e-mail</h2>
                        <label for="email">E-mail</label>
                        <input type="email" id="email" name="email" placeholder="seu@email.com" required>
                        <button class="step-btn" type="submit">Enviar código</button>
                    </div>
                </form>
            <% } %>

            <% if (etapa === 'codigo') { %>
                <form class="forgot-password-form" action="/esqueci-senha/codigo" method="post">
                    <div class="step">
                        <h2>Código de confirmação</h2>
                        <p>Insira o código de 6 dígitos que chegou no seu e-mail. Ele vale por 15 minutos.</p>
                        <label for="codigo">Código</label>
                        <input type="text" id="codigo" name="codigo" placeholder="000000" maxlength="6"
                               inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" required>
                        <button class="step-btn" type="submit">Continuar</button>
                    </div>
                </form>
                <p class="redefinir-link">Não recebeu ou digitou o e-mail errado? <a href="/esqueci-senha?recomecar=1">Começar de novo</a></p>
            <% } %>

            <% if (etapa === 'nova-senha') { %>
                <form class="forgot-password-form" action="/esqueci-senha/nova-senha" method="post">
                    <div class="step">
                        <h2>Nova senha</h2>
                        <p>Crie uma nova senha e confirme para concluir a recuperação.</p>
                        <label for="senha">Nova senha</label>
                        <input type="password" id="senha" name="senha" placeholder="Mínimo 8 caracteres" minlength="8" required>
                        <label for="confirmar_senha">Confirmar nova senha</label>
                        <input type="password" id="confirmar_senha" name="confirmar_senha" placeholder="Repita a nova senha" minlength="8" required>
                        <button class="step-btn" type="submit">Redefinir senha</button>
                    </div>
                </form>
            <% } %>

            <% if (etapa === 'concluido') { %>
                <div class="done-section">
                    <p class="done-title">Tudo certo!</p>
                    <img class="done-icon" src="/img/icons/verificar.png" alt="Ícone de sucesso">
                    <p class="done-text">Sua senha foi redefinida com sucesso.</p>
                    <a class="done-btn" href="/login">Voltar para o login</a>
                </div>
            <% } %>
        </div>
    </main>
</body>

</html>
