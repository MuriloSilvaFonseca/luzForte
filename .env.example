# Copie este arquivo para .env e preencha com os dados do SEU MySQL.
# O .env nunca vai para o GitHub.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=luz_forte

# Porta do servidor (vazio = 3000)
PORT=

# Assina o cookie de login. Vazio = o servidor sorteia um a cada início (os logins caem ao reiniciar).
# Para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# EmailJS (esqueci a senha). As chaves ficam só aqui, nunca em public/
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# WhatsApp da loja (botão "Enviar pedido pelo WhatsApp"). Formato: 5519XXXXXXXXX
# Para testar, use o seu próprio número. Vazio = o botão não aparece.
WHATSAPP_LOJA=
